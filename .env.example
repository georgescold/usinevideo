# =============================================================================
#  .env  --  reglages de la chaine.  Les CLES API ne vivent PAS ici :
#  elles sont dans config/keys.json (pool rotatif, voir config/keys.example.json)
#  Copie ce fichier en .env et ajuste. Tout a une valeur par defaut qui marche.
# =============================================================================

# --- Identite ---------------------------------------------------------------
# Sert a nommer les rendus et a preremplir les metadonnees.
CHAINE_ID=ma-chaine
LANGUE=fr

# --- Voix -------------------------------------------------------------------
# Voix ElevenLabs cible du speech-to-speech (voice changer). Tu enregistres avec
# TA voix et TON intonation, ElevenLabs ne remplace que le timbre.
ELEVENLABS_VOICE_ID=
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2
# Reduction du bruit de fond a l'entree du STS (true = micro moyen, piece vivante)
ELEVENLABS_REMOVE_NOISE=true

# --- Transcription locale (gratuite, hors ligne, GPU) -----------------------
# Modeles whisper.cpp : tiny / base / small / medium / large-v3
# En francais, 'medium' est le bon compromis. 'large-v3' si le rendu compte plus
# que le temps de calcul.
WHISPER_MODELE=medium
WHISPER_LANGUE=fr
# Accélération NVIDIA de la transcription (environ 20× plus rapide). Le moteur adapté
# se télécharge tout seul au premier usage (270 Mo, une fois pour toutes).
WHISPER_GPU=false

# --- Montage ----------------------------------------------------------------
# Silence considere comme coupable au-dela de cette duree (secondes)
COUPE_SILENCE_MIN=0.35
# Marge laissee autour de la parole pour ne pas manger les attaques (secondes)
COUPE_MARGE=0.08
# Seuil de detection du silence en dBFS
COUPE_SEUIL_DB=-34

# --- Rendu ------------------------------------------------------------------
# Nombre de threads de rendu Remotion. 0 = automatique.
RENDU_CONCURRENCE=0
RENDU_CRF=18
# Acceleration materielle NVIDIA (RTX). 'auto' teste et retombe sur le CPU.
RENDU_ACCEL=auto

# --- Veille -----------------------------------------------------------------
# Nombre de videos remontees par requete lors d'une veille YouTube
VEILLE_TAILLE=40
# Age maximum des videos analysees, en jours
VEILLE_FRAICHEUR=365
