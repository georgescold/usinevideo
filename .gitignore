# --- Secrets : ne sortent JAMAIS du poste -----------------------------------
.env
config/keys.json
# Les sauvegardes ecrites par les outils avant d'ecraser un fichier de config :
# elles portent l'etat d'un poste a un instant, pas une decision de la chaine.
config/*.precedent
config/.trousseau-etat.json
config/.voix-catalogue.json
**/*.key

# --- Dependances ------------------------------------------------------------
node_modules/
.venv/
__pycache__/
*.pyc

# --- Media lourds : regenerables ou irrecuperables, jamais versionnes -------
videos/*/02-tournage/
videos/*/03-audio/
videos/*/06-rendu/
# `05-montage/` voyage — c'est ce que dit le §4 — mais son sous-dossier `public/`
# non : Remotion y recopie les plans de coupe telecharges et la piste voix, soit
# trois cents megaoctets que `npm run monte` reconstruit a partir du plan. Le
# plan, lui, pese quatre-vingts kilooctets et reste versionne.
videos/*/05-montage/public/
veille/youtube/miniatures/
veille/youtube/raw/
veille/tiktok/media/
veille/tiktok/raw/
# Les vidéos rapatriées au carnet d'inspirations pèsent des dizaines de
# mégaoctets et se retéléchargent d'une commande. L'index et les transcripts,
# eux, restent versionnés : ce sont eux qu'on relit, et ils tiennent en
# kilooctets.
veille/inspirations/media/
veille/inspirations/raw/
# Les extraits de voix recoltes : plusieurs megaoctets de wav par empreinte, et
# ils se refont d'une commande a partir des sources. `empreinte.json` reste
# versionne — c'est lui qui porte les adresses, les durees et les mesures, donc
# de quoi tout reconstruire.
marque/voix/*/extraits/
marque/voix/*/reference.wav
# Le modele entrainé pèse 60 Mo et son index 30 : ils se refont a partir des
# extraits. `modele.json` reste versionne — il dit sur quoi et comment.
marque/voix/*/modele/*.pth
marque/voix/*/modele/*.index
assets/broll/
assets/musique/
assets/sfx/
remotion/out/
outils/bin/
outils/modeles/

# --- Caches -----------------------------------------------------------------
.cache/
*.log
.remotion/

# --- Ancien projet, conserve comme reference le temps de la migration -------
Youtube automatisé/

# --- Systeme ----------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# Permissions locales, propres a chaque poste
.claude/settings.local.json

# Les vidéos mises de côté : elles attendent une décision, pas un versionnement.
videos/.corbeille/
